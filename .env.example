# Next.js reads these from .env.local
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# docker compose reads these from .env
TZ=Europe/London
N8N_ENCRYPTION_KEY=
N8N_PUBLIC_URL=

# Convex deployment env, set with `npx convex env set NAME value`, never in a file:
# CLERK_FRONTEND_API_URL, LENDLOOP_HMAC_SECRET, N8N_WEBHOOK_URL
